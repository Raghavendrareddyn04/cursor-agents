[Unit]
Description=Hermes Agent Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/.hermes/hermes-agent
Environment=HOME=/root
Environment=HERMES_HOME=/root/.hermes
Environment=PATH=/root/.local/bin:/root/.hermes/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=VIRTUAL_ENV=/root/.hermes/hermes-agent/venv
ExecStart=/root/.hermes/hermes-agent/venv/bin/python -m hermes_cli.main gateway run
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
