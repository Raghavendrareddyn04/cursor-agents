# Hermes secrets — copy to ~/.hermes/.env on the VPS
# NEVER commit the real .env file. Rotate keys if exposed.

# --- LLM (pick one or more) ---
GEMINI_API_KEY=your-google-ai-studio-key
# GOOGLE_API_KEY=          # alias for Gemini
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Hermes API server (required for Jarvis + external clients) ---
API_SERVER_ENABLED=true
API_SERVER_KEY=generate-with-openssl-rand-hex-32

# --- Jarvis HUD auth (browser password, one-time per device) ---
JARVIS_HUD_TOKEN=jarvis-change-me

# --- ElevenLabs TTS (Jarvis voice) ---
ELEVENLABS_API_KEY=your-elevenlabs-key

# --- Optional: open gateway to all users (dev only) ---
# GATEWAY_ALLOW_ALL_USERS=true
